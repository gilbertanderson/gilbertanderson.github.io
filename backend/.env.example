# Copy to backend/.env for local overrides. All optional.

# Postgres (Neon, Supabase, Render…). Unset = local SQLite at backend/data/site.db.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Extra browser origins allowed to call the API, comma-separated.
# CORS_ORIGINS=https://www.example.com

# Email each contact message on (optional).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# CONTACT_TO=
