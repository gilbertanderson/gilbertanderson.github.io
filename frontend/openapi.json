{
  "openapi": "3.1.0",
  "info": {
    "title": "Gilbert Anderson Site API",
    "version": "2.0.0"
  },
  "paths": {
    "/api/content": {
      "get": {
        "tags": [
          "content"
        ],
        "summary": "Read Content",
        "operationId": "getContent",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteContent"
                }
              }
            }
          }
        }
      }
    },
    "/api/contact": {
      "post": {
        "tags": [
          "contact"
        ],
        "summary": "Send Contact",
        "operationId": "sendContact",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactMessage"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactReceipt"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ContactMessage": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email"
          },
          "message": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "email",
          "message"
        ],
        "title": "ContactMessage"
      },
      "ContactReceipt": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "detail"
        ],
        "title": "ContactReceipt"
      },
      "ContactSection": {
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "title": "Heading"
          },
          "blurb": {
            "type": "string",
            "title": "Blurb",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "heading"
        ],
        "title": "ContactSection"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HowBuilt": {
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "title": "Heading"
          },
          "blurb": {
            "type": "string",
            "title": "Blurb",
            "default": ""
          },
          "points": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Points"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "heading",
          "points"
        ],
        "title": "HowBuilt"
      },
      "Link": {
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "title": "Label"
          },
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label",
          "url"
        ],
        "title": "Link"
      },
      "Project": {
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "title": "Kind",
            "description": "Short category tag, e.g. 'React'."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "title": "Description"
          },
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url"
          },
          "category": {
            "type": "string",
            "enum": [
              "design",
              "development"
            ],
            "title": "Category",
            "default": "development"
          },
          "link_label": {
            "type": "string",
            "title": "Link Label",
            "default": "View on GitHub"
          },
          "image": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image",
            "description": "Path under frontend/public, e.g. /projects/dive-log.png."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "kind",
          "description",
          "url"
        ],
        "title": "Project"
      },
      "Role": {
        "properties": {
          "company": {
            "type": "string",
            "minLength": 1,
            "title": "Company"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "period": {
            "type": "string",
            "minLength": 1,
            "title": "Period",
            "description": "Display text, e.g. 'Jul 2023 \u2013 Jul 2025'."
          },
          "highlights": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Highlights"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "company",
          "title",
          "period",
          "highlights"
        ],
        "title": "Role"
      },
      "Site": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title",
            "description": "Short role line shown above the headline."
          },
          "headline": {
            "type": "string",
            "minLength": 1,
            "title": "Headline"
          },
          "bio": {
            "type": "string",
            "title": "Bio",
            "default": ""
          },
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url"
          },
          "accent": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "title": "Accent",
            "default": "#2E4BE0"
          },
          "accent_on_dark": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "title": "Accent On Dark",
            "default": "#9DB0FF"
          },
          "banner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Banner",
            "description": "Profile banner, path under frontend/public."
          },
          "avatar": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar",
            "description": "Profile photo, path under frontend/public."
          },
          "resume": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resume",
            "description": "Path under frontend/public, e.g. /Resume.docx."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "title",
          "headline",
          "url"
        ],
        "title": "Site"
      },
      "SiteContent": {
        "properties": {
          "site": {
            "$ref": "#/components/schemas/Site"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array",
            "title": "Links"
          },
          "projects": {
            "items": {
              "$ref": "#/components/schemas/Project"
            },
            "type": "array",
            "minItems": 1,
            "title": "Projects"
          },
          "experience": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "type": "array",
            "title": "Experience",
            "default": []
          },
          "tools": {
            "items": {
              "$ref": "#/components/schemas/ToolGroup"
            },
            "type": "array",
            "title": "Tools"
          },
          "credentials": {
            "items": {
              "$ref": "#/components/schemas/ToolGroup"
            },
            "type": "array",
            "title": "Credentials",
            "default": []
          },
          "how_built": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HowBuilt"
              },
              {
                "type": "null"
              }
            ]
          },
          "contact": {
            "$ref": "#/components/schemas/ContactSection"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "site",
          "links",
          "projects",
          "tools",
          "contact"
        ],
        "title": "SiteContent"
      },
      "ToolGroup": {
        "properties": {
          "group": {
            "type": "string",
            "minLength": 1,
            "title": "Group"
          },
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "group",
          "items"
        ],
        "title": "ToolGroup"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
