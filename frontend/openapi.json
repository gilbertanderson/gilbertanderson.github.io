{
  "openapi": "3.1.0",
  "info": {
    "title": "Gilbert Anderson Site API",
    "version": "2.0.0"
  },
  "paths": {
    "/api/content": {
      "get": {
        "tags": [
          "content"
        ],
        "summary": "Read Content",
        "operationId": "getContent",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteContent"
                }
              }
            }
          }
        }
      }
    },
    "/api/contact": {
      "post": {
        "tags": [
          "contact"
        ],
        "summary": "Send Contact",
        "operationId": "sendContact",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactMessage"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactReceipt"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Article": {
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "default": ""
          },
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Where it was published, e.g. 'Medium'.",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "title": "Article"
      },
      "ContactMessage": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email"
          },
          "message": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "email",
          "message"
        ],
        "title": "ContactMessage"
      },
      "ContactReceipt": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "detail"
        ],
        "title": "ContactReceipt"
      },
      "ContactSection": {
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "title": "Heading"
          },
          "blurb": {
            "type": "string",
            "title": "Blurb",
            "default": ""
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone",
            "description": "Display text, e.g. '504-233-3599'."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "heading"
        ],
        "title": "ContactSection"
      },
      "Demo": {
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "title": "Label"
          },
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url"
          },
          "hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hint",
            "description": "Short note shown next to the label in the menu."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label",
          "url"
        ],
        "title": "Demo"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HowBuilt": {
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "title": "Heading"
          },
          "blurb": {
            "type": "string",
            "title": "Blurb",
            "default": ""
          },
          "points": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Points"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "heading",
          "points"
        ],
        "title": "HowBuilt"
      },
      "Link": {
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "title": "Label"
          },
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label",
          "url"
        ],
        "title": "Link"
      },
      "LinkedInPost": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text",
            "description": "The post text, or your own commentary on a repost."
          },
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url"
          },
          "date": {
            "type": "string",
            "minLength": 1,
            "title": "Date",
            "description": "Display date, e.g. 'Nov 2026'."
          },
          "context": {
            "type": "string",
            "title": "Context",
            "description": "Optional one-line note, e.g. what the post is reposting.",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "url",
          "date"
        ],
        "title": "LinkedInPost"
      },
      "Position": {
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "period": {
            "type": "string",
            "minLength": 1,
            "title": "Period"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note",
            "description": "Optional line under the title, e.g. the program or employer."
          },
          "highlights": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Highlights"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "period"
        ],
        "title": "Position",
        "description": "One title held at a company, shown nested under it like LinkedIn does."
      },
      "Project": {
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "title": "Kind",
            "description": "Short category tag, e.g. 'React'."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "title": "Description"
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url",
            "description": "Repository or live link; leave out for unreleased work."
          },
          "category": {
            "type": "string",
            "enum": [
              "design",
              "development"
            ],
            "title": "Category",
            "default": "development"
          },
          "link_label": {
            "type": "string",
            "title": "Link Label",
            "default": "View on GitHub"
          },
          "demos": {
            "items": {
              "$ref": "#/components/schemas/Demo"
            },
            "type": "array",
            "title": "Demos",
            "description": "Playable or live versions; two or more appear as a Play it menu.",
            "default": []
          },
          "article_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Article Url",
            "description": "Optional write-up, e.g. a blog post about the project."
          },
          "image": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image",
            "description": "Path under frontend/public, e.g. /projects/dive-log.png."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "kind",
          "description"
        ],
        "title": "Project"
      },
      "Role": {
        "properties": {
          "company": {
            "type": "string",
            "minLength": 1,
            "title": "Company"
          },
          "logo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Logo",
            "description": "Company logo, path under frontend/public."
          },
          "period": {
            "type": "string",
            "minLength": 1,
            "title": "Period",
            "description": "Display text, e.g. 'Jul 2023 – Jul 2025'."
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "highlights": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Highlights",
            "default": []
          },
          "positions": {
            "items": {
              "$ref": "#/components/schemas/Position"
            },
            "type": "array",
            "title": "Positions",
            "description": "Several titles at one company, newest first.",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "company",
          "period"
        ],
        "title": "Role"
      },
      "Site": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title",
            "description": "Short role line shown above the headline."
          },
          "headline": {
            "type": "string",
            "minLength": 1,
            "title": "Headline"
          },
          "headline_highlights": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Headline Highlights",
            "description": "Words in the headline shown in the accent color.",
            "default": []
          },
          "bio": {
            "type": "string",
            "title": "Bio",
            "default": ""
          },
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url"
          },
          "accent": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "title": "Accent",
            "default": "#0B63CE"
          },
          "accent_on_dark": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "title": "Accent On Dark",
            "default": "#6CB2FF"
          },
          "banner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Banner",
            "description": "Profile banner, path under frontend/public."
          },
          "avatar": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar",
            "description": "Profile photo, path under frontend/public."
          },
          "resume": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resume",
            "description": "Path under frontend/public, e.g. /Resume.docx."
          },
          "resume_pdf": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resume Pdf",
            "description": "PDF copy of the resume, path under frontend/public."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "title",
          "headline",
          "url"
        ],
        "title": "Site"
      },
      "SiteContent": {
        "properties": {
          "site": {
            "$ref": "#/components/schemas/Site"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array",
            "title": "Links"
          },
          "projects": {
            "items": {
              "$ref": "#/components/schemas/Project"
            },
            "type": "array",
            "minItems": 1,
            "title": "Projects"
          },
          "experience": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "type": "array",
            "title": "Experience",
            "default": []
          },
          "stats": {
            "items": {
              "$ref": "#/components/schemas/Stat"
            },
            "type": "array",
            "title": "Stats",
            "default": []
          },
          "tools": {
            "items": {
              "$ref": "#/components/schemas/ToolGroup"
            },
            "type": "array",
            "title": "Tools"
          },
          "core_skills": {
            "items": {
              "$ref": "#/components/schemas/SkillLevel"
            },
            "type": "array",
            "title": "Core Skills",
            "default": []
          },
          "credentials": {
            "items": {
              "$ref": "#/components/schemas/ToolGroup"
            },
            "type": "array",
            "title": "Credentials",
            "default": []
          },
          "writing": {
            "items": {
              "$ref": "#/components/schemas/Article"
            },
            "type": "array",
            "title": "Writing",
            "default": []
          },
          "linkedin_posts": {
            "items": {
              "$ref": "#/components/schemas/LinkedInPost"
            },
            "type": "array",
            "title": "Linkedin Posts",
            "default": []
          },
          "how_built": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HowBuilt"
              },
              {
                "type": "null"
              }
            ]
          },
          "contact": {
            "$ref": "#/components/schemas/ContactSection"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "site",
          "links",
          "projects",
          "tools",
          "contact"
        ],
        "title": "SiteContent"
      },
      "SkillLevel": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "level": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Level"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "level"
        ],
        "title": "SkillLevel",
        "description": "A headline skill shown as a card with a progress bar (level is 0 to 100)."
      },
      "Stat": {
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1,
            "title": "Value",
            "description": "The figure as shown, e.g. '15+'."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "title": "Label"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "value",
          "label"
        ],
        "title": "Stat",
        "description": "A headline figure shown in the By the numbers strip; use only figures already on the resume."
      },
      "ToolGroup": {
        "properties": {
          "group": {
            "type": "string",
            "minLength": 1,
            "title": "Group"
          },
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "group",
          "items"
        ],
        "title": "ToolGroup"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
